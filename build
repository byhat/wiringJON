#!/bin/sh -e
#
# build:
#	wiringJON build & install script (mirrors the classic wiringPi ./build)
#	Builds core, devLib, gpio and wiringPiD; installs into /usr/local.
#	Usage: ./build            — build + install (sudo) + udev rule
#	       ./build test       — build only, no install
#	       ./build debian     — build a .deb into debian-template/
#	       ./build uninstall
#	       ./build clean
#################################################################################

sudo=${WIRINGPI_SUDO-sudo}
cmd=${1:-install}

fail ()
{
  echo "Make failed ($1)... check the messages above."
  exit 1
}

build_all ()
{
  for d in wiringPi devLib gpio wiringPiD examples ; do
    echo "--- $d"
    make -C $d || fail $d
  done
}

case x$cmd in

xtest)
  build_all
  ;;

xclean)
  for d in wiringPi devLib gpio wiringPiD examples ; do make -C $d clean ; done
  rm -f debian-template/wiringjon*.deb
  ;;

xuninstall)
  for d in wiringPi devLib gpio wiringPiD ; do $sudo make -C $d uninstall ; done
  ;;

xdebian)
  vMaj=$(cut -d. -f1 VERSION) ; vMin=$(cut -d. -f2 VERSION)
  debroot=$(pwd)/debian-template/wiringjon
  rm -rf $debroot/usr
  build_all
  for d in wiringPi devLib gpio wiringPiD ; do
    make -C $d install DESTDIR=$debroot/usr PREFIX=
  done
  ARCH=$(dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null || echo arm64)
  export VERSION=$vMaj.$vMin ARCH
  if command -v envsubst >/dev/null ; then
    envsubst < debian-template/wiringjon/DEBIAN/control_template > debian-template/wiringjon/DEBIAN/control
  else
    sed -e "s/\${VERSION}/$VERSION/" -e "s/\${ARCH}/$ARCH/" \
        < debian-template/wiringjon/DEBIAN/control_template > debian-template/wiringjon/DEBIAN/control
  fi
  cd debian-template
  fakeroot dpkg-deb --build --root-owner-group wiringjon 2>/dev/null \
    || dpkg-deb --build --root-owner-group wiringjon
  cd ..
  echo "Deb built in debian-template/"
  ;;

xinstall|*)
  echo "wiringJON Build script"
  echo "======================"
  echo
  for d in wiringPi devLib gpio wiringPiD ; do
    $sudo make -C $d uninstall >/dev/null 2>&1 || true
  done
  build_all
  for d in wiringPi devLib gpio wiringPiD ; do
    $sudo make -C $d install
  done
  if [ -d /etc/udev/rules.d ] ; then
    $sudo install -m 0644 udev/99-wiringjon.rules /etc/udev/rules.d/ || true
    $sudo udevadm trigger >/dev/null 2>&1 || true
    echo "installed udev rule 99-wiringjon.rules"
  fi
  echo
  echo "All Done."
  echo ""
  echo "NOTE: To compile programs with wiringJON, add -lwiringPi"
  echo "      (and -lwiringPiDev for device-level code)."
  echo ""
  ;;
esac
